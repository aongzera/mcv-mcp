# Credentials used to log in to MyCourseVille.
# Copy this file to `.env` and fill it in. `.env` is gitignored - never commit it.
MCV_USERNAME=6xxxxxxx21
MCV_PASSWORD=

# Which login button this account uses on mycourseville.com:
#   itchula = the "IT Chula" SSO button  (default)
#   mcv     = the plain username/password form on mycourseville.com
MCV_LOGIN_METHOD=itchula

# How often the background poller refreshes (minutes). Default 30, minimum 10.
MCV_POLL_MINUTES=30

# Set to 0 to disable the background poller entirely (tools still work, use sync_now).
MCV_POLL_ENABLED=1

# Optional: override where state (sqlite db, cookies, downloads) is stored.
# Defaults to %LOCALAPPDATA%\mcv_mcp on Windows, ~/.local/share/mcv_mcp elsewhere.
# MCV_STATE_DIR=
